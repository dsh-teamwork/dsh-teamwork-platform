{
  "name": "dsh-teamwork",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=24.19.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:setup": "cd dev && ./setup.sh",
    "dev:stop": "cd dev && ./stop.sh",
    "dev:clean": "cd dev && ./clean.sh",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:docs": "node scripts/lint-docs.mjs",
    "lint:lang": "node scripts/check-language.mjs",
    "test": "turbo run test",
    "tsc": "turbo run typecheck",
    "prepare": "husky",
    "db:drift": "turbo run db:drift",
    "assets:icons": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "sharp": "^0.35.3",
    "turbo": "2.10.11"
  }
}
