{
  "name": "dsh-teamwork",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=24.19.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@dsh-teamwork/web",
    "dev:setup": "cd dev && ./setup.sh",
    "dev:stop": "cd dev && ./stop.sh",
    "dev:clean": "cd dev && ./clean.sh",
    "dev:shared": "\"${SHUSHUO_DEV:-$HOME/code/shushuo/dev}/setup.sh\"",
    "dev:shared:status": "\"${SHUSHUO_DEV:-$HOME/code/shushuo/dev}/status.sh\"",
    "dev:shared:stop": "\"${SHUSHUO_DEV:-$HOME/code/shushuo/dev}/stop.sh\"",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@dsh-teamwork/web",
    "lint": "turbo run lint",
    "lint:docs": "node scripts/lint-docs.mjs",
    "lint:lang": "node scripts/check-language.mjs",
    "test": "turbo run test",
    "tsc": "turbo run typecheck",
    "postinstall": "turbo run db:generate --filter=@dsh-teamwork/db",
    "prepare": "husky",
    "db:studio": "turbo run db:studio --filter=@dsh-teamwork/db",
    "db:migrate": "turbo run db:migrate --filter=@dsh-teamwork/db",
    "db:deploy": "turbo run db:deploy --filter=@dsh-teamwork/db",
    "db:drift": "turbo run db:drift --filter=@dsh-teamwork/db",
    "db:push": "turbo run db:push --filter=@dsh-teamwork/db",
    "db:generate": "turbo run db:generate --filter=@dsh-teamwork/db",
    "db:reset": "turbo run db:reset --filter=@dsh-teamwork/db",
    "db:seed": "turbo run db:seed --filter=@dsh-teamwork/db",
    "assets:icons": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "sharp": "^0.35.3",
    "turbo": "2.10.11"
  }
}
