# Pre-push: the local run of CI.
#
# It runs the same steps, in the same order, as `.github/workflows/ci.yaml`,
# before a branch leaves the machine. The two are meant to stay in step — a
# step added there belongs here as well.
#
# To skip it on a work-in-progress branch: `git push --no-verify`. That is an
# escape hatch for a branch nobody will merge yet, not a way to land a red main.

set -u

red() { printf '\033[1;31m%s\033[0m\n' "$1"; }

run() {
  label=$1
  shift
  printf '\n\033[1m▶ %s\033[0m\n' "$label"
  if ! "$@"; then
    printf '\n'
    red "✗ pre-push stopped at: $label"
    printf '  Fix it and push again, or bypass with: git push --no-verify\n\n'
    exit 1
  fi
}

printf '\033[1mRunning CI locally before pushing…\033[0m\n'

run 'Type check      (pnpm tsc)' pnpm tsc

run 'Language check  (pnpm lint:lang)' pnpm lint:lang

run 'Docs check      (pnpm lint:docs)' pnpm lint:docs

run 'Icons check     (pnpm assets:icons --check)' pnpm assets:icons --check

run 'Lint            (pnpm lint)' pnpm lint

# Skips with a warning without MIGRATE_DEV_POSTGRES and MIGRATE_DEV_MYSQL (see
# server/scripts/drift.mjs), so a laptop without those databases can still push.
run 'Migration drift (pnpm db:drift)' pnpm db:drift

# The Go suites run every database case on SQLite, and on Postgres and MySQL
# where TEST_POSTGRES_URL and TEST_MYSQL_URL name a server; CI sets both, so
# those cases are never skipped there.
run 'Test            (pnpm test)' pnpm test

run 'Build           (pnpm build)' pnpm build

# The DSH plugin, unchanged, against the Go server (server/e2e). It needs the
# plugin's checkout beside this one, or DSH_TEAMWORK_PLUGIN; without either it
# skips with a warning, and CI runs it.
plugin=${DSH_TEAMWORK_PLUGIN:-../dsh-teamwork}
if [ -f "$plugin/lib/client.js" ]; then
  # Absolute, since the test resolves it from server/e2e.
  DSH_TEAMWORK_PLUGIN=$(cd "$plugin" && pwd)
  export DSH_TEAMWORK_PLUGIN
  # Every Go module with an e2e directory: the open server's, and the closed
  # one's where this tree has it.
  for dir in $(git ls-files '*e2e/*_test.go' | xargs -n1 dirname | sort -u); do
    run "Plugin e2e      ($dir)" sh -c "cd '$dir/..' && go test -tags e2e ./e2e"
  done
else
  printf '\n\033[1;33m! Plugin e2e skipped: no DSH plugin at %s\033[0m\n' "$plugin"
fi

# The closed edition only: every open path must equal the community edition
# it last merged (docs/tech/community-edition.md, "How the two stay in step").
if [ -f premium/scripts/lint-edition.mjs ]; then
  run 'Edition boundary (premium/scripts/lint-edition.mjs)' node premium/scripts/lint-edition.mjs
fi

printf '\n\033[1;32m✓ CI passed locally — pushing.\033[0m\n\n'
