# Pre-push: the local run of CI.
#
# It runs the same steps, in the same order, as `.github/workflows/ci.yaml`,
# before a branch leaves the machine. The two are meant to stay in step — a
# step added there belongs here as well.
#
# In the closed edition (where premium/ exists) it is the only check a pull
# request gets: its repository is private, so CI skips pull requests and runs
# only after a merge into main. There nothing may skip — the Postgres the
# closed suites need and the plugin's checkout are required, and a push
# without them is refused. The closed edition runs on SQLite and Postgres
# only, and the open server's own suites are not run there: its
# files equal the community edition's (the edition boundary below), whose CI
# ran them on all three databases. Here, in the open edition, CI runs on every
# pull request, so a laptop without the databases may push and CI covers what
# it skipped.
#
# To skip it on a work-in-progress branch: `git push --no-verify`. That is an
# escape hatch for a branch nobody will merge yet, not a way to land a red main.

set -u

# The root .env, read as `pnpm dev` reads it (scripts/dev.mjs): Node's own
# parser, and a variable the shell already sets wins. It is where the test
# databases `pnpm dev:setup` prints can live instead of every shell's export.
if [ -f .env ]; then
  envs=$(node <<'JS'
const before = new Set(Object.keys(process.env));
process.loadEnvFile('.env');
// Each new variable as an export the shell reads back, single-quoted.
const quote = (v) => `'${v.replaceAll("'", `'\\''`)}'`;
for (const [k, v] of Object.entries(process.env)) {
  if (!before.has(k) && /^[A-Za-z_][A-Za-z0-9_]*$/.test(k)) console.log(`export ${k}=${quote(v)}`);
}
JS
  ) || exit 1
  eval "$envs"
fi

red() { printf '\033[1;31m%s\033[0m\n' "$1"; }

run() {
  label=$1
  shift
  printf '\n\033[1m▶ %s\033[0m\n' "$label"
  if ! "$@"; then
    printf '\n'
    red "✗ pre-push stopped at: $label"
    printf '  Fix it and push again, or bypass with: git push --no-verify\n\n'
    exit 1
  fi
}

printf '\033[1mRunning CI locally before pushing…\033[0m\n'

plugin=${DSH_TEAMWORK_PLUGIN:-../dsh-teamwork}
# What leaves out the open server's suites in an edition; empty here.
open=''
if [ -d premium ]; then
  open='--filter=!@dsh-teamwork/go-server'
  missing=''
  for var in TEST_POSTGRES_URL MIGRATE_DEV_POSTGRES; do
    eval "value=\${$var:-}"
    [ -n "$value" ] || missing="$missing $var"
  done
  if [ -n "$missing" ] || [ ! -f "$plugin/lib/client.js" ]; then
    printf '\n'
    red '✗ pre-push refused: the closed edition runs all of CI here, and nothing may skip'
    [ -z "$missing" ] || printf '  Not set:%s\n  Run pnpm dev:setup and export the variables it prints.\n' "$missing"
    [ -f "$plugin/lib/client.js" ] || printf '  No built DSH plugin at %s: clone dsh-teamwork beside this checkout and run pnpm build there, or set DSH_TEAMWORK_PLUGIN.\n' "$plugin"
    printf '  For a work-in-progress branch nobody will merge yet: git push --no-verify\n\n'
    exit 1
  fi
fi

run 'Type check      (pnpm tsc)' pnpm tsc

run 'Language check  (pnpm lint:lang)' pnpm lint:lang

run 'Docs check      (pnpm lint:docs)' pnpm lint:docs

run 'Icons check     (pnpm assets:icons --check)' pnpm assets:icons --check

run 'Lint            (pnpm lint)' pnpm lint

# Skips with a warning without MIGRATE_DEV_POSTGRES and MIGRATE_DEV_MYSQL (see
# server/scripts/drift.mjs), so a laptop without those databases can still push
# the open edition; the closed one was refused above.
run 'Migration drift (pnpm db:drift)' pnpm db:drift $open

# The Go suites run every database case on SQLite, and on Postgres and MySQL
# where TEST_POSTGRES_URL and TEST_MYSQL_URL name a server; CI sets both, and
# the closed edition requires Postgres above.
run 'Test            (pnpm test)' pnpm test $open

run 'Build           (pnpm build)' pnpm build

# The DSH plugin, unchanged, against the Go server (server/e2e). It needs the
# plugin's checkout beside this one, or DSH_TEAMWORK_PLUGIN; without either the
# open edition skips it with a warning, and CI runs it.
if [ -f "$plugin/lib/client.js" ]; then
  # Absolute, since the test resolves it from server/e2e.
  DSH_TEAMWORK_PLUGIN=$(cd "$plugin" && pwd)
  export DSH_TEAMWORK_PLUGIN
  # Every Go module with an e2e directory: the open server's, or the closed
  # one's where this tree has it.
  for dir in $(git ls-files '*e2e/*_test.go' | xargs -n1 dirname | sort -u); do
    [ -z "$open" ] || [ "$dir" != server/e2e ] || continue
    run "Plugin e2e      ($dir)" sh -c "cd '$dir/..' && go test -tags e2e ./e2e"
  done
else
  printf '\n\033[1;33m! Plugin e2e skipped: no DSH plugin at %s\033[0m\n' "$plugin"
fi

# The closed edition only: every open path must equal the community edition
# it last merged (docs/tech/community-edition.md, "How the two stay in step").
if [ -f premium/scripts/lint-edition.mjs ]; then
  run 'Edition boundary (premium/scripts/lint-edition.mjs)' node premium/scripts/lint-edition.mjs
fi

printf '\n\033[1;32m✓ CI passed locally — pushing.\033[0m\n\n'
