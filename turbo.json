{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "web-build/**"]
    },
    // The console it embeds is built first (its devDependency), and copied
    // into internal/web/dist by the console's own build.
    "@dsh-teamwork/go-server#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    // The web app reads three variables at build, which strict env mode would
    // otherwise strip: LEGAL_DIR renders /privacy and /terms (ADR 0007), APP_URL
    // is the origin the static robots.txt, sitemap and canonicals name and the
    // www redirect keeps (canonical-host.mjs), and AUTH_URL outranks it there.
    // The legal documents live outside the package, so they join the cache key
    // too; the glob covers any tree's docs/legal/ without naming one.
    "@dsh-teamwork/web#build": {
      "dependsOn": ["^build", "^db:generate"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["LEGAL_DIR", "APP_URL", "AUTH_URL"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/**/docs/legal/*.md"]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": [],
      "dependsOn": ["^build", "^db:generate"]
    },
    "typecheck": {
      "outputs": [],
      "dependsOn": ["^build", "^db:generate"]
    },
    "db:generate": {
      "cache": false,
      "outputs": []
    },
    // Cacheable, unlike the generic entry above: the schema names its own output
    // directory (`prisma/schema/schema.prisma` -> `../../src/generated/prisma`), so the
    // client lands inside the package where turbo can own it, and it is a pure
    // function of the schema plus the pinned prisma version — which the
    // lockfile already puts in turbo's global hash.
    "@dsh-teamwork/db#db:generate": {
      "inputs": ["prisma/schema/**"],
      "outputs": ["src/generated/**"]
    },
    "db:deploy": {
      "cache": false,
      "outputs": []
    },
    "db:drift": {
      "cache": false,
      "outputs": []
    },
    "db:push": {
      "cache": false,
      "outputs": []
    },
    "db:migrate": {
      "cache": false,
      "outputs": []
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "db:reset": {
      "cache": false,
      "outputs": []
    },
    "db:seed": {
      "cache": false,
      "outputs": []
    }
  },
  // turbo runs every task in strict env mode: a variable not named here never
  // reaches the task. DATABASE_URL has to be, or `db:deploy` and `db:drift`
  // would silently fall back to prisma.config.ts's local default and act on a
  // database nobody pointed them at. It also changes which database a test
  // runs on (PGlite without it, Postgres with it), so it belongs in every
  // cache key, as does PGLITE_DIR, the PGlite data directory.
  "globalEnv": [
    "DATABASE_URL",
    "SHADOW_DATABASE_URL",
    "PGLITE_DIR",
    // The Go server's suites run on Postgres and MySQL where these name a
    // server (server/internal/testdb), so they change what a test proves.
    "TEST_POSTGRES_URL",
    "TEST_MYSQL_URL"
  ],
  // Read by the db:* scripts but not part of any result, so passed through
  // rather than hashed. Without this, turbo's strict env mode strips
  // ALLOW_REMOTE_MIGRATE_DEV and the documented escape hatch never reaches
  // assert-local-database.mjs.
  "globalPassThroughEnv": ["ALLOW_REMOTE_MIGRATE_DEV", "DRIFT_SHADOW_DATABASE_URL", "MIGRATE_DEV_POSTGRES", "MIGRATE_DEV_MYSQL", "GOPATH", "GOCACHE", "GOMODCACHE"],
  "ui": "tui"
}
