{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    // Every Go task compiles the embedded console. The server's build copies
    // the built console in (server/scripts/embed.mjs) and keeps the copy as an
    // output, so a cache hit restores it; lint and test wait for that build
    // rather than copying it themselves.
    "@dsh-teamwork/go-server#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "internal/web/dist/**"]
    },
    "@dsh-teamwork/go-server#lint": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "@dsh-teamwork/go-server#test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    // The console reads LEGAL_DIR at build: /privacy and /terms are rendered
    // from it (ADR 0007). The legal documents live outside the package, so
    // they join the cache key too; the glob covers any tree's docs/legal/
    // without naming one.
    "@dsh-teamwork/console#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["LEGAL_DIR"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/**/docs/legal/*.md"]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": [],
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "outputs": [],
      "dependsOn": ["^build"]
    },
    "db:drift": {
      "cache": false,
      "outputs": []
    }
  },
  // turbo runs every task in strict env mode: a variable not named here never
  // reaches the task. The Go server's suites run on Postgres and MySQL where
  // these name a server (server/internal/testdb), so they change what a test
  // proves and belong in every cache key.
  "globalEnv": ["TEST_POSTGRES_URL", "TEST_MYSQL_URL"],
  // Read by db:drift and the Go toolchain but not part of any result, so
  // passed through rather than hashed.
  "globalPassThroughEnv": ["MIGRATE_DEV_POSTGRES", "MIGRATE_DEV_MYSQL", "GOPATH", "GOCACHE", "GOMODCACHE"],
  "ui": "tui"
}
