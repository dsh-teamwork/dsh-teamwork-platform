# Optional. With nothing set, prisma.config.ts falls back to the `pnpm dev:setup`
# stack below; a real environment variable always beats this file.
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/dsh_teamwork

# Where `pnpm db:drift` replays the migrations. Without it the drift check skips
# with a warning (and the pre-push hook says so).
SHADOW_DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/dsh_teamwork_shadow
