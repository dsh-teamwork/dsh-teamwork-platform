# Copy to .env. Every value below reaches the `pnpm dev:setup` stack as is.

# Where this app is served from, when it is not the host the request names
# (behind a proxy that rewrites Host). Also the origin canonical URLs, Open Graph
# and sitemap.xml name: set it in every deployment.
APP_URL=

# Database (packages/db reads this file too).
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/dsh_teamwork

# ── Sign-in: NextAuth strategy ───────────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=
# Only when the deployment's public URL differs from the host requests arrive on.
AUTH_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Sign-in codes are sent over SMTP, e.g. smtps://user:password@smtp.example.com:465
# (the hosted service uses Resend's: smtps://resend:<API key>@smtp.resend.com:465).
# Unset in development, the code is printed to the server console instead;
# unset anywhere else, none is sent.
SMTP_URL=
AUTH_EMAIL_FROM=DSH Teamwork <no-reply@example.com>

# ── Product analytics (PostHog) ─────────────────────────────────────────────
# The project's `phc_` key: write-only, and bundled into the browser on purpose.
# The browser sends anonymous pageviews (cookieless); the server sends account
# events under User.id. Unset, both are off. docs/ops/analytics.md.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Model gateway (/api/llm/chat/completions) ────────────────────────────────
# Provider name → OpenAI-compatible base URL (https only) and the name of the
# variable that holds its key. A team model names one of these providers; the
# key never leaves the server. Unset, team models answer 503.
# e.g. {"deepseek":{"baseURL":"https://api.deepseek.com/v1","apiKeyEnv":"DEEPSEEK_API_KEY"}}
LLM_ROUTES_JSON=
DEEPSEEK_API_KEY=
