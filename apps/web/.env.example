# Copy to .env. Every value below reaches the `pnpm dev:setup` stack as is.

# The public origin this app is served from, e.g. https://teamwork.example.com.
# Auth.js builds its callback URLs from it (behind a proxy the request names the
# container, and Google refuses that callback), and canonical URLs, Open Graph,
# sitemap.xml and the www/apex redirect name it. Set it in every deployment.
APP_URL=

# Database (packages/db reads this file too). Empty: PGlite in-process, in
# PGLITE_DIR (default ~/.dsh-teamwork/db), migrated on first connect.
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/dsh_teamwork
PGLITE_DIR=

# ── Sign-in: NextAuth strategy ───────────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Sign-in codes are sent over SMTP, e.g. smtps://user:password@smtp.example.com:465
# (the hosted service uses Resend's: smtps://resend:<API key>@smtp.resend.com:465).
# Unset, sign-in is an email and a password instead: the server prints a link
# that claims the first account, and team admins create everyone else's.
SMTP_URL=
AUTH_EMAIL_FROM=DSH Teamwork <no-reply@example.com>
# Optional: the phone app's own address, e.g. dshteamwork://sign-in. A sign-in
# page opened with a redirect_uri under it sends the code there after the person
# confirms, instead of showing it to paste. Unset, codes are only ever shown.
MOBILE_REDIRECT_URI=

# ── Product analytics (PostHog) ─────────────────────────────────────────────
# The project's `phc_` key: write-only, and bundled into the browser on purpose.
# The browser sends anonymous pageviews (cookieless); the server sends account
# events under User.id. Unset, both are off. docs/ops/analytics.md.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Model gateway (/api/llm/chat/completions) ────────────────────────────────
# Each team's admin enters its providers and keys in /team (ADR 0006). The keys
# are stored encrypted under this secret: 32 random bytes in base64
# (`openssl rand -base64 32`). Unset, no provider can be added or called;
# changed, every stored key must be entered again.
PROVIDER_KEYS_SECRET=
# `true` lets a provider live on loopback or a private network, over https or
# plain http (a model the team serves itself). Leave it unset where strangers
# share the instance: an address is then a way to reach this server's network.
ALLOW_PRIVATE_PROVIDERS=

# Optional: a directory holding this deployment's privacy.md and terms.md,
# absolute or relative to the repository root. Read at build into /privacy and
# /terms, which the home page footer and the sitemap then link; unset, neither
# page exists. It is a build setting: changing it means building again.
LEGAL_DIR=
